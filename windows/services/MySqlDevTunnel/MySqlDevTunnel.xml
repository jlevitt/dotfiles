<service>
    <id>MySqlDevTunnel</id>
    <name>MySql Dev Tunnel (jlevitt.dev-ca1.internal.pos-api.com)</name>
    <executable>tsh</executable>
    <arguments>ssh -N -L 3307:localhost:3306 oloadmin@jlevitt</arguments>
    <startmode>Automatic</startmode>
    <delayedAutoStart>true</delayedAutoStart>
    <log mode="roll-by-size">
        <sizeThreshold>10240</sizeThreshold>
        <keepFiles>4</keepFiles>
    </log>
    <onfailure action="restart" delay="30 sec" />
    <onfailure action="restart" delay="5 min" />
    <onfailure action="none" />
    <resetfailure>1 hour</resetfailure>
    <!-- Refreshing the service config on start needs rights the NT SERVICE account doesn't have. -->
    <autoRefresh>false</autoRefresh>
</service>
